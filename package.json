{
  "name": "ideahub",
  "version": "0.1.0",
  "private": true,
  "description": "An intelligent second brain for capturing, connecting, and evolving your thoughts.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm --parallel --filter @ideahub/api --filter @ideahub/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:generate": "typedoc",
    "openapi:check": "pnpm --filter @ideahub/api openapi:check",
    "db:generate": "pnpm --filter @ideahub/api db:generate",
    "db:migrate": "pnpm --filter @ideahub/api db:migrate",
    "db:studio": "pnpm --filter @ideahub/api db:studio"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "concurrently": "9.2.1",
    "eslint": "10.3.0",
    "prettier": "3.8.3",
    "typedoc": "0.28.19",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.1"
  }
}
